<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>SAPB1DIConnectinJava</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SAP Business One DI API Connect</name>
    <description>SAP B1 DI API 连接示例项目</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <gson.version>2.10.1</gson.version>

        <!-- SAP B1 DI API 路径配置 -->
        <sap.di.api.path>C:/Program Files/SAP/SAP Business One DI API/JCO/LIB</sap.di.api.path>
    </properties>

    <dependencies>
        <!-- Gson for JSON parsing -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- SAP B1 DI API - sboapi.jar -->
        <dependency>
            <groupId>com.sap.b1</groupId>
            <artifactId>sboapi</artifactId>
            <version>10.0</version>
            <scope>system</scope>
            <systemPath>${sap.di.api.path}/sboapi.jar</systemPath>
        </dependency>

        <!-- SAP B1 DI API - sbowrapper.jar -->
        <dependency>
            <groupId>com.sap.b1</groupId>
            <artifactId>sbowrapper</artifactId>
            <version>10.0</version>
            <scope>system</scope>
            <systemPath>${sap.di.api.path}/sbowrapper.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <!-- 添加外部 JAR 到编译 classpath -->
                    <compilerArgs>
                        <arg>-extdirs</arg>
                        <arg>${sap.di.api.path}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin (for testing) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${sap.di.api.path}/sboapi.jar</additionalClasspathElement>
                        <additionalClasspathElement>${sap.di.api.path}/sbowrapper.jar</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>

            <!-- Exec Maven Plugin -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.example.sapb1.Main</mainClass>
                    <!-- 添加 SAP JAR 到运行 classpath -->
                    <additionalClasspathElements>
                        <additionalClasspathElement>${sap.di.api.path}/sboapi.jar</additionalClasspathElement>
                        <additionalClasspathElement>${sap.di.api.path}/sbowrapper.jar</additionalClasspathElement>
                    </additionalClasspathElements>
                    <systemProperties>
                        <systemProperty>
                            <key>java.library.path</key>
                            <value>${sap.di.api.path}</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>

            <!-- Maven Jar Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.sapb1.Main</mainClass>
                            <addClasspath>true</addClasspath>
                        </manifest>
                        <manifestEntries>
                            <!-- 添加外部 JAR 到 manifest -->
                            <Class-Path>
                                ${sap.di.api.path}/sboapi.jar ${sap.di.api.path}/sbowrapper.jar
                            </Class-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>